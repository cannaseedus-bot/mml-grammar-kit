<?xml version="1.0" encoding="UTF-8"?>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">

  <!--
    phase-driver-chen.mml

    CHEN-µ contract:
      Verify and prove structured comparisons using WCR and track data.
      Never perform unproven or conflicting evaluations.

    Content dictionary used here: urn:kuhul:phase-driver-chen:v1
  -->

  <!-- ── Identity ──────────────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>chen</mi>
      <mo>_</mo>
      <mi>&#x03BC;</mi>
      <mo>=</mo>
      <mo>&#x27E8;</mo>
      <mi>phase</mi><mo>,</mo>
      <mi>T</mi><mo>,</mo>
      <mi>role</mi>
      <mo>&#x27E9;</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <eq/>
        <apply><csymbol cd="urn:kuhul:phase-driver-chen:v1">Identity</csymbol><ci>chen</ci></apply>
        <list>
          <cn>Ch'en</cn>
          <cn>0.45</cn>
          <ci>role</ci>
        </list>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
chen_mu = &lt;phase=Ch'en, T=0.45, role&gt;
Role: Verify, prove, structured comparison
Phase angle: theta = 4&#x03C0;/3
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── Capability ────────────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>Cap</mi>
      <mo>(</mo><mi>chen</mi><mo>)</mo>
      <mo>=</mo>
      <mi>GRANTED</mi>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:phase-driver-chen:v1">Capability</csymbol>
        <ci>chen</ci>
        <ci>granted</ci>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
CAN: Verify and prove structured comparisons using WCR and track data.
SUPPLIES: Provide fold and gram data to XCFE and Xul.
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── Authority boundary ────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>&#x0394;B</mi>
      <mo>&#x2209;</mo>
      <mi>Auth</mi>
      <mo>(</mo><mi>chen</mi><mo>)</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:phase-driver-chen:v1">AuthorityBoundary</csymbol>
        <apply><notin/><ci>DeltaTopology</ci><ci>Auth_chen</ci></apply>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
CANNOT: Never perform unproven or conflicting evaluations.
BOUNDARY: Cannot access topology or commit to Ch'en verdict.
Delta_B not-in Auth(chen): topology commits require Proposal -&gt; Ch'en -&gt; XCFE -&gt; Xul.
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── WCR scoring position ───────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>S</mi>
      <mo>=</mo>
      <msub><mi>W</mi><mi>&#x03BC;</mi></msub>
      <mo>&#x22C5;</mo>
      <msub><mi>C</mi><mi>&#x03BC;</mi></msub>
      <mo>&#x22C5;</mo>
      <msub><mi>R</mi><mi>&#x03BC;</mi></msub>
      <mo>(</mo><mi>Q</mi><mo>)</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <eq/>
        <ci>S</ci>
        <apply>
          <times/>
          <apply><selector/><ci>W</ci><ci>mu</ci></apply>
          <apply><selector/><ci>C</ci><ci>mu</ci></apply>
          <apply>
            <csymbol cd="urn:kuhul:phase-driver-chen:v1">Relevance</csymbol>
            <ci>Q</ci>
          </apply>
        </apply>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
S = W_mu * C_mu * R_mu(Q)
W_mu: static weight for chen in its capability family.
C_mu: confidence earned through Ch'en-verified outcomes.
R_mu(Q): query-relevance score at phase Ch'en (T=0.45).
Eligibility: chen is admitted to the candidate set only when requires(op) subset-of capabilities(chen).
    </annotation>
  </semantics>

  <semantics>
    <mrow>
      <mi>SharedPatternKernelRef</mi><mo>=</mo>
      <mtext>data/grammar/PatternKernelCalls.mml</mtext>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:pattern-kernel-calls:v1">UsesSharedPatternKernel</csymbol>
        <list><ci>MicronautPatterns</ci><ci>DaemonPatterns</ci><ci>SraiOperators</ci>
          <ci>aiml-functions</ci><ci>map-filter-fold</ci><ci>CheeseCritic</ci></list>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
This daemon/Micronaut uses the shared typed pattern-call contract. It invokes
only registered operations applicable to its role, phase, context, and scope;
the shared reference does not grant capabilities or execution authority.
    </annotation>
  </semantics>

</math>
